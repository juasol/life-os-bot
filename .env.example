# ===== 必須 =====
# Discord BOT トークン（Discord Developer Portal → Bot → Token）
DISCORD_TOKEN=

# Claude API キー（https://console.anthropic.com/）
ANTHROPIC_API_KEY=

# 使用モデル（コスト調整用。未設定なら既定値）
# FAST=単純処理（抽出/分類/短文）, SMART=品質重視（要約/記事/AI秘書）
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_SMART=claude-sonnet-4-6

# ===== スプレッドシート連携 =====
# スプレッドシート ID
GOOGLE_SHEET_ID=

# サービスアカウント認証。次のどちらか一方でよい:
#  (A) ローカル: credentials.json をフォルダ直下に置く（このとき下行は空でOK）
#  (B) クラウド/GitHub運用: credentials.json の中身(JSON)を1行にして下に貼る
#      例: GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_CREDENTIALS_JSON=

# ===== チャンネル名（Discord で作成したチャンネル名に合わせる）=====
# 未設定の場合は下記の既定値が使われる。
# 注: Discord はラテン文字を小文字化するが（AI秘書 → ai秘書）、BOT 側で吸収するのでこのままでよい。
CHANNEL_WEIGHT=体重
CHANNEL_TODO=今日やること
CHANNEL_REVIEW=振り返り
CHANNEL_MONEY=お金
CHANNEL_IDEA=アイデア
CHANNEL_ARTICLE=気になる記事
CHANNEL_ASSISTANT=AI秘書
CHANNEL_REPORT=レポート
CHANNEL_PROFILE=プロフィール
CHANNEL_HABIT=習慣
# 健康トラッカー
CHANNEL_SLEEP=睡眠
CHANNEL_STOOL=便
CHANNEL_GUT=腸
CHANNEL_MEAL=食事
CHANNEL_COFFEE=コーヒー
CHANNEL_FOCUS=集中
CHANNEL_MOOD=気分
